# Sous-domaine du site (un enregistrement DNS A doit pointer vers l'IP du VPS).
DOMAIN=agripedia.creationapp.academy

# --- Traefik déjà en place sur le VPS (mêmes valeurs que les autres apps, cf. /opt/apps/proxy) ---
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
